{
  "$schema": "../../schemas/manifest-v2.schema.json",
  "id": "z-mind",
  "name": "Z-Mind Cognitive Engineering OS",
  "version": "1.10.0",
  "description": "Cognitive engineering OS: 56 engineering invariants across 6 pillars, plan synthesis, and workspace doctor.",
  "author": "kzxl",
  "license": "MIT",
  "kind": "domain-module",
  "main": "./scripts/mcp-server.mjs",
  "runtime": {
    "node": ">=22.0.0",
    "aeos": "^2.0.0",
    "os": [
      "win32",
      "linux",
      "darwin"
    ]
  },
  "capabilities": {
    "provides": [
      {
        "id": "capability:cognitive-invariants",
        "version": "1.1.0",
        "description": "56 rules governance, TDD reproduction plans, and workspace doctor."
      }
    ]
  },
  "mcp": {
    "server": {
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/scripts/mcp-server.mjs"
      ],
      "tools": [
        "zmind_init",
        "zmind_rules",
        "zmind_audit",
        "zmind_doctor",
        "zmind_status"
      ]
    }
  }
}
