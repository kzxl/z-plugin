{
  "name": "z-token",
  "version": "1.4.0",
  "description": "Compact-context tools and guards: code outline, capped search, compact .NET builds, oversized-read blocking, and token budgeting.",
  "author": {
    "name": "kzxl"
  },
  "skills": "skills",
  "agents": "agents",
  "commands": "commands",
  "hooks": "hooks/hooks.json",
  "mcpServers": {
    "z-token": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/mcp-server.mjs"
      ],
      "env": {
        "ZCODE_WORKSPACE_ROOT": "${ZCODE_PROJECT_DIR}"
      }
    }
  },
  "ui": {
    "surfaces": [
      {
        "id": "z-token",
        "title": {
          "en": "Z-Token",
          "zh-CN": "零冗余 Token"
        },
        "icon": "gauge",
        "server": "z-token",
        "resourceUri": "ui://z-token/panel.html",
        "availability": "session"
      }
    ]
  }
}
