{
  "z-token-guard": {
    "PreToolUse": [
      {
        "matcher": "read_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/guard.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|read_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/loop-breaker.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
