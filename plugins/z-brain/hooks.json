{
  "z-brain-guard": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/session-start.mjs",
        "timeout": 3
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|edit_file|write_file|write_to_file|create_file|search_replace|apply_patch|replace_file_content|multi_replace_file_content|multi_edit",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/observe.mjs record",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Bash|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/harvest-advisor.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/observe.mjs flush --quiet",
        "timeout": 3
      }
    ]
  }
}
