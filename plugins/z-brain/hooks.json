{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/session-start.mjs"],
            "timeoutMs": 3000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|run_command",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/harvest-advisor.mjs"],
            "timeoutMs": 5000
          }
        ]
      }
    ]
  }
}
