{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/session-start.mjs"],
            "timeoutMs": 3000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|edit_file|write_file|write_to_file|create_file|search_replace|apply_patch|replace_file_content|multi_replace_file_content|multi_edit",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/observe.mjs", "record"],
            "timeoutMs": 3000
          }
        ]
      },
      {
        "matcher": "Bash|run_command",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/harvest-advisor.mjs"],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/observe.mjs", "flush", "--quiet"],
            "timeoutMs": 3000
          }
        ]
      }
    ]
  }
}
